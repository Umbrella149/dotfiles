#!/bin/bash

# --- 颜色日志函数 ---
logError() {
  echo -e "\033[31m====== $1 ======\033[0m"
}
logWarning() {
  echo -e "\033[33m====== $1 ======\033[0m"
}
logInfo() {
  echo -e "\033[32m====== $1 ======\033[0m"
}
# ---------------------

# 检查 cr 指令后是否跟着文件名
if [ -z "$1" ]; then
  logError "请在 cr 指令后跟上文件名，如 test.cpp 或 test.c"
  exit 1
fi

# 获取文件名（不带扩展名）和扩展名
case "$1" in
*.cpp)
  sourceName="${1%.cpp}"
  fileExtension="cpp"
  ;;
*.c)
  sourceName="${1%.c}"
  fileExtension="c"
  ;;
*)
  sourceName="$1"
  fileExtension="" # 尝试猜测或使用默认
  ;;
esac

# 检查是否存在对应源文件
if [ -e "$sourceName.cpp" ]; then
  fileExtension="cpp"
elif [ -e "$sourceName.c" ]; then
  fileExtension="c"
else
  logError "该目录下没有 $sourceName.cpp 或 $sourceName.c，请输入 ls 检查文件是否存在，或使用 cd 跳转到源文件所在目录"
  exit 1
fi

# 确定编译器和编译选项
compileCommand=""
if [ "$fileExtension" = "cpp" ]; then
  # C++ 编译语句
  # mac 下默认的 c++ 是 clang，希望使用 gcc 可以将 c++ 替换为 c++-14
  logInfo "编译 C++ 文件：$sourceName.cpp"
  compileCommand="c++ \"$sourceName.cpp\" -o \"$sourceName\" -O2 --std=c++20 -DDEBUG -Wall -fdiagnostics-color=always"
elif [ "$fileExtension" = "c" ]; then
  # C 编译语句
  # 默认使用 gcc
  logInfo "编译 C 文件：$sourceName.c"
  compileCommand="gcc \"$sourceName.c\" -o \"$sourceName\" -lm -O2 --std=c11 -DDEBUG -Wall -fdiagnostics-color=always"
fi

# 执行编译
eval $compileCommand 2>&1 | tee _compile.log

# 编译失败检查
if grep -q "error:" _compile.log; then
  logError "编译失败，请检查上述语法错误"
  logError "查看红色 error 的信息，按住 command 点击 error 前面的文件坐标可以快速定位错误代码"
  rm _compile.log
  exit 1
fi

# 告警信息检查
if grep -q "warning" _compile.log; then
  logWarning "上述是告警信息，请检查（如在预期内则可忽略）"
fi

# 如果你不希望看到编译成功和执行结束的话，可以在 logInfo 前加上 #
logInfo "编译成功，开始执行"
rm _compile.log

# --- 执行程序 ---
# 检查 $sourceName 是否为绝对路径（以 / 开头）
if [ $# -ge 2 ]; then
  # 检查是否存在输入文件
  if [ ! -e "$2" ]; then
    logError "该目录下没有输入文件 $2，请输入 ls 检查文件是否存在"
    exit 1
  fi
  # 带有输入文件（重定向）
  if [[ "$sourceName" == /* ]]; then
    cat "$2" | "$sourceName"
  else
    cat "$2" | "./$sourceName"
  fi
else
  # 无输入文件
  if [[ "$sourceName" == /* ]]; then
    "$sourceName"
  else
    "./$sourceName"
  fi
fi

# 运行错误检查
if [ $? -ne 0 ]; then
  logError "运行错误，可能存在数组越界、除 0、野指针、栈溢出、爆内存等问题"
fi

logInfo "执行结束，删除可执行程序"
# 如果你不希望删除，可以在下面 rm 前加上 #
rm "$sourceName"
